 "securitySchemes": {
  "BoardSessionAuth": {
   "type": "apiKey",
   "in": "cookie",
   "name": "paperclip_session",
   "description": "Board session cookie in authenticated mode. Paperclip uses Better Auth; cookie transport may vary by deployment."
  },
  "BoardApiKeyAuth": {
   "type": "http",
   "scheme": "bearer",
   "bearerFormat": "Board API Key",
   "description": "Board API key presented in the Authorization bearer header."
  },
  "AgentBearerAuth": {
   "type": "http",
   "scheme": "bearer",
   "bearerFormat": "Agent API Key or Agent JWT",
   "description": "Agent API key or Paperclip-issued local agent JWT presented in the Authorization bearer header."
  }
 },
